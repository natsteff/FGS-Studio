      "blocks": [
        {
          "id": "header",
          "subtitle": "The hungriest zombies live forever.",
          "title": "Zombie Dice Records",
          "type": "header"
        }
      ],
      "id": "header_row"
    },
    {
      "blocks": [
        {
          "first_column_heading": "Record",
          "id": "prime_zombie",
          "players": [
            "Player",
            "Brains",
            "Date"
          ],
          "score_rows": [
